generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Business {
  id            String   @id @default(cuid())
  name          String
  category      String
  licenseNumber String
  address       String
  district      String
  lat           Float
  lng           Float
  ownerId       String
  supplier      String?
  status        String   @default("active")
  riskScore     Float    @default(50)
  riskTier      String   @default("B")
  registeredAt  DateTime @default(now())
  owner         User     @relation(fields: [ownerId], references: [id])
  inspections   Inspection[]
  complaints    Complaint[]
  documents     Document[]
  suppliers     Supplier[]
  riskSnapshots RiskSnapshot[]

  @@index([district])
  @@index([category])
  @@index([riskTier])
  @@index([status])
  @@index([licenseNumber])
}

model Supplier {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  category       String
  products       String
  location       String
  licenceNumber  String?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Inspection {
  id           String     @id @default(cuid())
  businessId   String
  officerId    String
  scheduledAt  DateTime
  completedAt  DateTime?
  checklist    Json
  notes        String?
  photos       String @default("[]")
  violations   Violation[]
  aiSummary    String?
  riskDelta    Float?
  status       String     @default("scheduled")
  business     Business   @relation(fields: [businessId], references: [id])
  officer      User       @relation(fields: [officerId], references: [id])

  @@index([businessId])
  @@index([officerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([completedAt])
}

model Violation {
  id           String     @id @default(cuid())
  inspectionId String
  type         String
  severity     String
  description  String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([type])
  @@index([severity])
}

model Complaint {
  id                  String    @id @default(cuid())
  businessId          String?
  citizenId           String?
  assignedOfficerId   String?
  anonymous           Boolean   @default(false)
  description         String
  type                String?
  photos              String    @default("[]")
  status              String    @default("submitted")
  createdAt           DateTime  @default(now())
  assignedAt          DateTime?
  investigationStartedAt DateTime?
  inspectionAt        DateTime?
  resolvedAt          DateTime?
  slaDays             Int       @default(7)
  lat                 Float?
  lng                 Float?
  address             String?
  district            String?
  aiAnalysis          String?
  business            Business? @relation(fields: [businessId], references: [id])
  citizen             User?     @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedOfficer     User?     @relation("AssignedComplaints", fields: [assignedOfficerId], references: [id])

  @@index([businessId])
  @@index([assignedOfficerId])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model Document {
  id          String    @id @default(cuid())
  businessId  String
  type        String
  fileUrl     String
  uploadedAt  DateTime  @default(now())
  expiresAt   DateTime?
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([expiresAt])
}

/// Deterministic, reproducible point-in-time risk scores. A snapshot stores the
/// factor breakdown that produced the score so historical movement is explainable.
model RiskSnapshot {
  id         String   @id @default(cuid())
  businessId String
  score      Float
  tier       String
  factors    Json
  snapshotAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, snapshotAt])
  @@index([snapshotAt])
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  password           String
  role               String
  district           String?
  businesses         Business[]
  inspections        Inspection[]
  complaints         Complaint[]   @relation("CitizenComplaints")
  assignedComplaints Complaint[]   @relation("AssignedComplaints")
}
